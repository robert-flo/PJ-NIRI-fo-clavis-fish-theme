# Generated by clavis-fish-theme init fish. Do not edit this output.
# It is intentionally Fish 4.1+ only and uses Fish's native final rendering.

if not status is-interactive
    return
end

function __clavis_fish_theme_version_at_least
    set -l current (string split '.' -- $FISH_VERSION)
    set -l required (string split '.' -- $argv[1])
    set -l current_major $current[1]
    set -l current_minor 0
    set -l required_major $required[1]
    set -l required_minor 0
    if set -q current[2]
        set current_minor $current[2]
    end
    if set -q required[2]
        set required_minor $required[2]
    end
    test $current_major -gt $required_major
    or test $current_major -eq $required_major -a $current_minor -ge $required_minor
end

if not __clavis_fish_theme_version_at_least 4.1
    printf '%s\n' 'clavis-fish-theme requires Fish 4.1 or newer.' >&2
    return
end

# Decode a generated Fish variable-style literal into the exact executable
# path resolved by the init process. No user-specific install path is
# hard-coded here.
set -g __clavis_fish_theme_binary (string unescape --style=var -- '__CLAVIS_FISH_THEME_BINARY__')
set -g fish_transient_prompt 1

# Remove only this package's event handler before re-registering it. Repeated
# `source` therefore does not accumulate handlers or duplicate state updates.
functions -e __clavis_fish_theme_mark_command 2>/dev/null
set -g __clavis_fish_theme_ignore_next_postexec 1
function __clavis_fish_theme_mark_command --on-event fish_postexec
    if test "$__clavis_fish_theme_ignore_next_postexec" = 1
        set -g __clavis_fish_theme_ignore_next_postexec 0
        return 0
    end
    set -g __clavis_fish_theme_command_seen 1
end

if not set -q __clavis_fish_theme_command_seen
    set -g __clavis_fish_theme_command_seen 0
end
set -g __clavis_fish_theme_state_ready 0

function fish_prompt
    # These are deliberately the first operations: Fish keeps the previous
    # command's status/pipestatus/duration available at prompt entry.
    set -l __clavis_captured_pipestatus $pipestatus
    set -l __clavis_captured_status $status
    set -l __clavis_captured_duration $CMD_DURATION

    set -l __clavis_seen $__clavis_fish_theme_command_seen
    if contains -- --final-rendering $argv
        # Native final rendering belongs to the prompt that is being saved.
        # Reuse the state captured by the normal prompt so fish_right_prompt
        # sees exactly the same values.
        if test "$__clavis_fish_theme_state_ready" != 1
            set -g __clavis_fish_theme_saved_status $__clavis_captured_status
            set -g __clavis_fish_theme_saved_pipestatus $__clavis_captured_pipestatus
            set -g __clavis_fish_theme_saved_duration $__clavis_captured_duration
            set -g __clavis_fish_theme_state_ready 1
        end
    else
        set -g __clavis_fish_theme_saved_status $__clavis_captured_status
        set -g __clavis_fish_theme_saved_pipestatus $__clavis_captured_pipestatus
        set -g __clavis_fish_theme_saved_duration $__clavis_captured_duration
        set -g __clavis_fish_theme_state_ready 1
    end

    set -l __clavis_pipe (string join ',' -- $__clavis_fish_theme_saved_pipestatus)
    set -l __clavis_columns 80
    if set -q COLUMNS; and test -n "$COLUMNS"
        set __clavis_columns $COLUMNS
    end

    if contains -- --final-rendering $argv
        "$__clavis_fish_theme_binary" prompt --transient-left \
            --terminal-width="$__clavis_columns" \
            --status="$__clavis_fish_theme_saved_status" \
            --pipestatus="$__clavis_pipe" \
            --cmd-duration="$__clavis_fish_theme_saved_duration" \
            --command-seen="$__clavis_seen"
    else
        "$__clavis_fish_theme_binary" prompt \
            --terminal-width="$__clavis_columns" \
            --status="$__clavis_fish_theme_saved_status" \
            --pipestatus="$__clavis_pipe" \
            --cmd-duration="$__clavis_fish_theme_saved_duration" \
            --command-seen="$__clavis_seen"
    end
end

function fish_right_prompt
    # Capture at entry as a fallback for Fish redraws that ask only for the
    # right prompt. Normally fish_prompt has already saved this cycle.
    set -l __clavis_captured_pipestatus $pipestatus
    set -l __clavis_captured_status $status
    set -l __clavis_captured_duration $CMD_DURATION

    if test "$__clavis_fish_theme_state_ready" != 1
        set -g __clavis_fish_theme_saved_status $__clavis_captured_status
        set -g __clavis_fish_theme_saved_pipestatus $__clavis_captured_pipestatus
        set -g __clavis_fish_theme_saved_duration $__clavis_captured_duration
        set -g __clavis_fish_theme_state_ready 1
    end

    if contains -- --final-rendering $argv
        set -l __clavis_pipe (string join ',' -- $__clavis_fish_theme_saved_pipestatus)
        set -l __clavis_columns 80
        if set -q COLUMNS; and test -n "$COLUMNS"
            set __clavis_columns $COLUMNS
        end
        "$__clavis_fish_theme_binary" prompt --transient-right \
            --terminal-width="$__clavis_columns" \
            --status="$__clavis_fish_theme_saved_status" \
            --pipestatus="$__clavis_pipe" \
            --cmd-duration="$__clavis_fish_theme_saved_duration" \
            --command-seen="$__clavis_fish_theme_command_seen"
    end
    # The ordinary right prompt must remain empty. Its first-line content is
    # already fill-aligned by the single Rust renderer invocation.
end
